{
  "fluidic_system": {
    "reservoirs": [
      {
        "id": "feed_tank",
        "role": "supply",
        "volume_ul": 1000000,
        "contents": "Demonstration transfer liquid"
      }
    ],
    "pumps": [
      {
        "id": "transfer_pump",
        "target_flow_rate_ul_min": 6000,
        "max_flow_rate_ul_min": 12000
      }
    ],
    "outlets": [
      {"id": "collection", "kind": "product"}
    ],
    "channels": [
      {
        "id": "supply_line",
        "source_id": "feed_tank",
        "target_id": "transfer_pump",
        "length_mm": 1000,
        "width_mm": 10,
        "height_mm": 5,
        "material": "acrylic",
        "fluid": "demo_liquid",
        "target_flow_rate_ul_min": 6000,
        "max_pressure_kpa": 2,
        "pump_id": "transfer_pump"
      },
      {
        "id": "delivery_line",
        "source_id": "transfer_pump",
        "target_id": "collection",
        "length_mm": 1000,
        "width_mm": 10,
        "height_mm": 5,
        "material": "acrylic",
        "fluid": "demo_liquid",
        "target_flow_rate_ul_min": 6000,
        "max_pressure_kpa": 2,
        "pump_id": "transfer_pump"
      }
    ],
    "fluids": [
      {
        "id": "demo_liquid",
        "dynamic_viscosity_pa_s": 0.001,
        "density_kg_m3": 1000,
        "provenance": "Explicit demonstration inputs; not measured process-fluid properties."
      }
    ]
  }
}
